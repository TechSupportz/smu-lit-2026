{
    "name": "smu-lit-sct-prefiling-server",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.5.0",
    "type": "module",
    "description": "SCT pre-filing agent harness for an internal unauthenticated demo.",
    "engines": {
        "node": ">=22.19.0"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "start": "node dist/server.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build"
    },
    "dependencies": {
        "@earendil-works/pi-ai": "^0.83.0",
        "@flue/cli": "^2.0.3",
        "@flue/runtime": "^2.0.3",
        "@flue/vite": "^2.0.3",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "hono": "^4.13.7",
        "nanoid": "^6.0.1",
        "valibot": "^1.4.2",
        "vite": "^8.2.2",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.4.1",
        "eslint": "^10.10.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.69.0",
        "vitest": "^5.0.0"
    }
}
