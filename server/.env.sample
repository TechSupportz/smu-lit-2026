# Copy to server/.env.
# Run the backend with server/ as its working directory.

# Main agent: Muse Spark 1.3 Contributor through OpenCode Go (Responses API).
# Contributor permits provider training on prompts/completions; see PRD.
OPENCODE_GO_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=muse-spark-1.3-contributor

# Evidence extraction: Gemini 3.8 Flash through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EXTRACTION_MODEL=google/gemini-3.8-flash

# Internal demo; no authentication. Change origin to the team's frontend URL.
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Paths relative to server/.
DATA_DIR=./data
FLUE_DB_PATH=./data/flue.db
CASE_DB_PATH=./data/cases.db
EVIDENCE_DIR=./data/evidence
SNAPSHOT_DIR=./data/snapshots
TYPST_BIN=typst

# Bounded evidence, model, network, and artifact work.
MAX_UPLOAD_BYTES=10485760
MAX_EVIDENCE_PAGES=80
MAX_MODEL_CALLS_PER_TURN=8
PROVIDER_TIMEOUT_MS=90000
PROVIDER_MAX_RETRIES=2
TYPST_TIMEOUT_MS=20000
