# Copy to server/.env.
# Run the backend with server/ as its working directory.

# Main agent: OpenAI GPT-5.6 Luna through OpenRouter.
OPENCODE_GO_KEY=
OPENCODE_GO_BASE_URL=https://openrouter.ai/api/v1
OPENCODE_GO_MODEL=openai/gpt-5.6-luna

# Evidence extraction through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EXTRACTION_MODEL=openai/gpt-5.6-luna

# Internal demo; no authentication. Change origin to the team's frontend URL.
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Exact comma-separated public hostnames accepted by the Vite development server.
# For a Quick Tunnel, use its generated hostname without https:// or a path.
VITE_ALLOWED_HOSTS=

# Optional streamable-HTTP MCP endpoint at /mcp. Keep disabled unless needed.
# No-token mode is suitable only while bound to loopback (for a private MCP tunnel).
# For other MCP clients, use a random bearer token of at least 32 characters. Public ChatGPT plugins
# with user-specific/write tools require OAuth 2.1 and user-owned case isolation.
MCP_ENABLED=false
MCP_ACCESS_TOKEN=

# Paths relative to server/.
DATA_DIR=./data
FLUE_DB_PATH=./data/flue.db
CASE_DB_PATH=./data/cases.db
EVIDENCE_DIR=./data/evidence
SNAPSHOT_DIR=./data/snapshots
TYPST_BIN=typst

# Bounded evidence, model, network, and artifact work.
MAX_UPLOAD_BYTES=10485760
MAX_EVIDENCE_PAGES=80
MAX_MODEL_CALLS_PER_TURN=8
PROVIDER_TIMEOUT_MS=90000
PROVIDER_MAX_RETRIES=2
TYPST_TIMEOUT_MS=20000
